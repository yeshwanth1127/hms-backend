APP_ENV=development
DATABASE_URL=postgresql+psycopg://avocado:avocado@localhost:5432/avocado
REDIS_URL=redis://localhost:6379/0
ALLOWED_ORIGINS=http://localhost:5567,http://127.0.0.1:5567
SLOT_HOLD_MINUTES=7
ADMIN_API_KEY=change-this-development-key
VOICE_SERVICE_API_KEY=change-this-voice-service-key
WHATSAPP_SERVICE_API_KEY=change-this-whatsapp-service-key
WHATSAPP_OWNER_SECRET=change-this-long-random-owner-secret
MEDIA_DIR=./uploads
# Production: private, backend-accessible ClamAV Unix socket.
# MEDIA_SCAN_SOCKET=/run/clamav/clamd.sock
# Reception details shown to patients. Use verified clinic information.
CLINIC_PHONE=
RECEPTION_HOURS=Contact the clinic for reception hours.
RECEPTION_RESPONSE=Reception will reply during opening hours.
# Safe default: no patient campaigns, staff replies or care outreach dispatched.
# Test jobs still require an explicitly configured verified recipient.
WHATSAPP_OUTREACH_ENABLED=false
WHATSAPP_TEST_RECIPIENTS=

# Staff UI shares the backend origin. Required HTTPS origin in production.
# STAFF_ORIGIN=https://staff.clinic.example
# Approved public booking origins for Google link preparation, comma-separated.
BOOKING_ALLOWED_ORIGINS=

# Optional PostHog aggregate reads. Separate from VITE_POSTHOG_KEY (browser capture).
POSTHOG_GROWTH_ENABLED=false
POSTHOG_API_HOST=https://us.posthog.com
# Set the numeric project ID and a project-restricted query:read key in your secret store.
# POSTHOG_PROJECT_ID=12345
POSTHOG_READ_KEY=
SARVAM_API_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_APP_ID=
SARVAM_APP_VERSION=
SARVAM_AGENT_DISPLAY_NAME=Aanya

# Optional Voice module: enable in Staff > Settings > Modules after configuration.
# Pin a published Sarvam version; the browser cannot override it.
SARVAM_API_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_APP_ID=
SARVAM_APP_VERSION=
SARVAM_AGENT_DISPLAY_NAME=Aanya
VOICE_CALLS_PER_IP_HOUR=5
VOICE_CALLS_PER_DAY=200
VOICE_MAX_CONCURRENT=10
VOICE_SESSION_MINUTES=20
# Verify the analytics response and use an exact dot-separated URL field path.
# Exact trusted HTTPS hostnames only, comma-separated, never wildcard domains.
SARVAM_RECORDING_URL_FIELD=
VOICE_RECORDING_HOSTS=
VOICE_RECORDING_ACCESS_DAYS=30

VOICE_WEBSITE_BOOKING_URL=/schedule-appointment

# Website booking uses the official WhatsApp bot for proof of phone ownership.
# Enable only after production clinic data and the signed Meta worker are ready.
WEB_BOOKING_ENABLED=false
WEB_BOOKING_ORIGIN=
# International WhatsApp business number, digits only (no +).
WHATSAPP_BOOKING_NUMBER=
