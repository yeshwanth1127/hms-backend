# Local phone test. Inject production secrets securely; never commit .env.
WA_ENV=development
WA_MODE=backend
WA_CLINIC_READY=false
WA_LIVE_NUMBER_CONFIRMED=false
WA_BIND_HOST=127.0.0.1
WA_LOCAL_PORT=8787
BACKEND_URL=http://127.0.0.1:8000
# Match WHATSAPP_SERVICE_API_KEY in the backend root .env.
BACKEND_WHATSAPP_SERVICE_KEY=change-this-whatsapp-service-key
WA_VERIFY_TOKEN=replace-with-a-long-random-string
WA_APP_SECRET=replace-with-meta-app-secret
WA_PHONE_NUMBER_ID=replace-with-meta-phone-number-id
WA_ACCESS_TOKEN=replace-with-meta-access-token
WA_GRAPH_VERSION=replace-with-version-from-meta-dashboard
# WA_WELCOME_IMAGE_PATH=/absolute/path/to/approved-clinic-image.png
# Enable reminders only after clinic approval and patient consent.
# WA_REMINDER_TEMPLATE_NAME=appointment_reminder
# WA_REMINDER_TEMPLATE_LANGUAGE=en
# Production: WA_ENV=production, WA_CLINIC_READY=true,
# WA_LIVE_NUMBER_CONFIRMED=true, WA_BIND_HOST=0.0.0.0,
# BACKEND_URL=https://private-api.example.com and approved WA_WELCOME_IMAGE_PATH.
# Run npm run preflight first. See PRODUCTION_DEPLOYMENT.md.
# Template sync requires whatsapp_business_management on the Meta token.
# WA_BUSINESS_ACCOUNT_ID=your-numeric-whatsapp-business-account-id
# Worker is opt-in. Enable this for test sends; patient delivery additionally
# requires WHATSAPP_OUTREACH_ENABLED=true in the backend.
WA_OUTREACH_ENABLED=false
